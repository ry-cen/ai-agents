{
  "cleanupPeriodDays": 180,
  "permissions": {
    "allow": []
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/t3/.claude/bin/context-checkpoint.py",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/t3/.claude/bin/context-checkpoint.py",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "skins@hellosverre-mods": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "claude-code-filetree": {
      "source": {
        "source": "git",
        "url": "https://github.com/data-goblin/claude-code-filetree.git"
      }
    },
    "claude-kit": {
      "source": {
        "source": "git",
        "url": "https://github.com/johnnyvizz/claude-kit.git"
      }
    },
    "hellosverre-mods": {
      "source": {
        "source": "git",
        "url": "https://github.com/hellosverre/claude-skins.git"
      }
    },
    "impeccable": {
      "source": {
        "source": "git",
        "url": "https://github.com/pbakaus/impeccable.git"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
