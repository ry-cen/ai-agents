#!/usr/bin/env bash
# Ask Codex (gpt-6.2-astra) for a second opinion. Replaces Claude Code's built-in advisor.
#
# Usage: codex-advise --role <agent-role> [-C dir] [-e effort] "question" [file ...]
#   The advisor does NOT see your transcript. Put everything it needs in the question:
#   the goal, what you decided or tried, the evidence, and what you want judged.
#   Listed files (brief, diff, logs) are inlined; it can also read the repo under -C (read-only).
# Every call is logged to ~/.claude/codex-advise.log.jsonl for the token audit.
set -euo pipefail

role="unknown" dir="$PWD" effort="${CODEX_ADVISE_EFFORT:-medium}" model="${CODEX_ADVISE_MODEL:-gpt-6.2-astra}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --role) role="$2"; shift 2 ;;
    -C) dir="$2"; shift 2 ;;
    -e) effort="$2"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[[ $# -ge 1 ]] || { echo "codex-advise: missing question (see --help)" >&2; exit 2; }
question="$1"; shift

prompt="You are a senior advisor to another coding agent (role: $role). It is asking for a second opinion.
Do not edit files or run anything that changes state; read files under the working directory if you need to check a claim.
Answer in under 300 words: the main risks or mistakes you see, then the concrete next step you recommend. Say plainly if the plan looks right.

QUESTION:
$question"
for f in "$@"; do
  prompt+=$'\n\n'"--- FILE: $f ---"$'\n'"$(head -c 60000 "$f")"
done

out=$(mktemp -t codex-advise.XXXXXX)
err=$(mktemp -t codex-advise-err.XXXXXX)
start=$(date +%s)
if codex exec -m "$model" -c "model_reasoning_effort=\"$effort\"" -s read-only \
     --skip-git-repo-check --ephemeral --color never -C "$dir" -o "$out" "$prompt" >/dev/null 2>"$err"; then
  rc=0
else
  rc=$?
fi
printf '{"ts":"%s","role":"%s","cwd":"%s","model":"%s","effort":"%s","prompt_chars":%d,"secs":%d,"rc":%d}\n' \
  "$(date -u +%FT%TZ)" "$role" "$dir" "$model" "$effort" "${#prompt}" "$(( $(date +%s) - start ))" "$rc" \
  >> ~/.claude/codex-advise.log.jsonl

if [[ $rc -ne 0 || ! -s "$out" ]]; then
  echo "codex-advise: Codex failed (exit $rc). Continue without the advisor." >&2
  tail -5 "$err" >&2
  rm -f "$out" "$err"; exit 1
fi
cat "$out"; rm -f "$out" "$err"
