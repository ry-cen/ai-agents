prefix_rule(pattern=["node", "verify-portals.mjs", "--strict"], decision="allow")
prefix_rule(pattern=["node", "scan.mjs"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\np = Path(\"data/pipeline.md\")\nlines = p.read_text().splitlines()\npattern = re.compile(r\"\\b(?:Interns?|Internship|Manager|Director|Staff|Principal)\\b\", re.I)\nout = []\nremoved = []\nfor line in lines:\n    if line.startswith(\"- [ ] \"):\n        parts = line.split(\" | \")\n        if len(parts) >= 3 and pattern.search(parts[2]):\n            removed.append(line)\n            continue\n    out.append(line)\nassert len(removed) == 79, f\"Expected 79 scanner-added title mismatches, got {len(removed)}\"\np.write_text(\"\\n\".join(out).rstrip() + \"\\n\")\nprint(f\"Removed {len(removed)} intern and leadership titles from pending pipeline.\")\nPY"], decision="allow")
